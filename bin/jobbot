#!/usr/bin/env bash
# jobbot — atalho único para o ciclo de vida do bot em Docker.
#
#   ./bin/jobbot chrome     abre o Chrome NATIVO (janela real, teclado real)
#   ./bin/jobbot up          sobe o container (usa o Chrome do host se existir)
#   ./bin/jobbot up --local  força o Chrome dentro do container (noVNC)
#   ./bin/jobbot down        derruba tudo
#   ./bin/jobbot logs        segue o log (Ctrl+C sai)
#   ./bin/jobbot status      mostra o estado
#   ./bin/jobbot shell       abre um shell no container
#   ./bin/jobbot rebuild     reconstrói a imagem e sobe de novo
#   ./bin/jobbot ui          só imprime a URL da UI
#
# Watcher (abre o Chrome sozinho quando o container sobe):
#   ./bin/jobbot watch install   instala como serviço do systemd (1x)
#   ./bin/jobbot watch start     liga o serviço
#   ./bin/jobbot watch stop      pausa
#   ./bin/jobbot watch status    estado do serviço
#   ./bin/jobbot watch logs      log do watcher
#   ./bin/jobbot watch uninstall desinstala
#   ./bin/jobbot watch run       roda em foreground (Ctrl+C sai)
#
# As portas ficam no .env (BOT_UI_PORT, BOT_NOVNC_PORT, BOT_CDP_PORT).
set -euo pipefail

cd "$(dirname "$0")/.."

# Carrega o .env sem exportar commented lines.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

UI_PORT="${BOT_UI_PORT:-1717}"
NOVNC_PORT="${BOT_NOVNC_PORT:-7900}"
CDP_PORT="${BOT_CDP_PORT:-9222}"
COMPOSE=(docker compose)

c() { printf '\033[36m%s\033[0m\n' "$*"; }
ok() { printf '\033[32m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }
erro() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# Detecta se há um Chrome do host com CDP na porta configurada.
cdp_do_host_vivo() {
  curl -sf -m 2 "http://127.0.0.1:${CDP_PORT}/json/version" >/dev/null 2>&1
}

modo() {
  # aceita "host", "--host", "local", "--local" e "auto"
  local m="${1:-auto}"
  m="${m#--}"
  case "$m" in
    host) echo host ;;
    local) echo local ;;
    auto)
      if cdp_do_host_vivo; then echo host; else echo local; fi
      ;;
    *) erro "modo inválido: $1 (use: auto|host|local)"; exit 1 ;;
  esac
}

# Remove containers de execução única (`docker compose run`), que ficam
# órfãos com nome aleatório e sem restart policy.
limpar_containers_run() {
  local ids
  ids="$(docker ps -aq --filter "name=^auto-apply-bot.*-run-" 2>/dev/null || true)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086
    docker rm -f $ids >/dev/null 2>&1 && warn "containers de 'docker compose run' anteriores foram removidos"
  fi
}

cmd_up() {
  local arg="${1:-auto}"
  local sem_chrome=false
  [ "$arg" = "--no-chrome" ] && { sem_chrome=true; arg="auto"; }

  # Containers criados com `docker compose run` ficam órfãos (nome aleatório,
  # sem restart policy) e disputam as portas com o container oficial. Limpa
  # antes de subir, para o ambiente ficar previsível.
  limpar_containers_run

  # Modo AUTO: se não houver Chrome com CDP, ABRE o Chrome nativo do host —
  # a janela real, com teclado, é o que o usuário espera ver. Só caímos para o
  # Chrome do container se ele não puder ser aberto.
  local m
  if [ "$arg" = "auto" ] && [ "$sem_chrome" = false ]; then
    if cdp_do_host_vivo; then
      m="host"
    else
      c "→ Nenhum Chrome com CDP encontrado — abrindo o Chrome nativo..."
      if cmd_chrome >/dev/null 2>&1 && cdp_do_host_vivo; then
        m="host"
      else
        warn "Não foi possível abrir o Chrome do host — usando o Chrome do container."
        m="local"
      fi
    fi
  else
    m="$(modo "$arg")"
  fi

  if [ "$m" = "host" ]; then
    c "→ Modo HOST: usando o Chrome do host (CDP ${CDP_PORT})"
    "${COMPOSE[@]}" up -d bot
    ok "UI: http://localhost:${UI_PORT}"
    c "   Chrome nativo aberto em janela real (profile dedicado, logins persistem)"
  else
    c "→ Modo CONTAINER: Chrome dentro do container (noVNC)"
    "${COMPOSE[@]}" --profile container up -d bot-container
    ok "UI:    http://localhost:${UI_PORT}"
    ok "noVNC: http://localhost:${NOVNC_PORT}   (login / CAPTCHA)"
  fi
}

cmd_down() {
  c "→ Derrubando (modo host + container)..."
  "${COMPOSE[@]}" --profile container down --remove-orphans
  ok "Feito. (os volumes e o banco foram preservados)"
}

cmd_logs() {
  "${COMPOSE[@]}" --profile host-chrome logs -f --tail=100
}

cmd_status() {
  c "Portas: UI=${UI_PORT} | noVNC=${NOVNC_PORT} | CDP=${CDP_PORT}"
  if cdp_do_host_vivo; then
    ok "Chrome do host: VIVO (modo host disponível)"
  else
    warn "Chrome do host: sem CDP em ${CDP_PORT} (modo host indisponível)"
  fi
  "${COMPOSE[@]}" --profile host-chrome ps
  echo
  curl -sf -m 3 "http://localhost:${UI_PORT}/api/status" 2>/dev/null \
    | head -c 400 && echo || warn "UI não responde em http://localhost:${UI_PORT}"
}

cmd_shell() {
  local cname="auto-apply-bot"
  docker ps --format '{{.Names}}' | grep -q "^auto-apply-bot-container$" && cname="auto-apply-bot-container"
  "${COMPOSE[@]}" exec "$cname" bash
}

cmd_rebuild() {
  c "→ Rebuild da imagem…"
  "${COMPOSE[@]}" build
  cmd_up "${1:-auto}"
}

cmd_ui() {
  echo "http://localhost:${UI_PORT}"
}

# ========== WATCHER (abre o Chrome quando o container sobe) ==========

WATCH_UNIT="jobbot-watch"
WATCH_DIR="${HOME}/.config/systemd/user"
WATCH_FILE="${WATCH_DIR}/${WATCH_UNIT}.service"

cmd_watch() {
  local sub="${1:-help}"
  shift || true

  case "$sub" in
    install)
      mkdir -p "$WATCH_DIR"
      # O unit aponta para o próprio script (caminho absoluto do usuário).
      sed "s|%h/auto-apply-bot|$(pwd)|g" bin/jobbot-watch.service > "$WATCH_FILE"
      systemctl --user daemon-reload
      systemctl --user enable --now "$WATCH_UNIT"
      ok "Watcher instalado e ativo."
      c "   status:  ./bin/jobbot watch status"
      c "   desinstalar: ./bin/jobbot watch uninstall"
      ;;
    uninstall)
      systemctl --user disable --now "$WATCH_UNIT" 2>/dev/null || true
      rm -f "$WATCH_FILE"
      systemctl --user daemon-reload 2>/dev/null || true
      ok "Watcher removido."
      ;;
    start)   systemctl --user start "$WATCH_UNIT" && ok "Watcher ligado." ;;
    stop)    systemctl --user stop "$WATCH_UNIT" && ok "Watcher pausado." ;;
    restart) systemctl --user restart "$WATCH_UNIT" && ok "Watcher reiniciado." ;;
    status)
      if systemctl --user is-active --quiet "$WATCH_UNIT"; then
        ok "Watcher ATIVO (o Chrome abre junto com o container)"
      else
        warn "Watcher inativo — use './bin/jobbot watch install' para ativar"
      fi
      systemctl --user --no-pager status "$WATCH_UNIT" 2>/dev/null | head -8 || true
      ;;
    logs)    journalctl --user -u "$WATCH_UNIT" -f ;;
    run|"")  exec "$(dirname "$0")/jobbot-watch" ;;
    *) erro "subcomando inválido: watch $sub"; exit 1 ;;
  esac
}

# Abre o Chrome NATIVO no host, com a porta de CDP liberada.
#
# Por que um profile dedicado (--user-data-dir) e obrigatorio: desde o
# Chrome 136, o navegador recusa depuracao remota no profile padrao (o
# seu perfil do dia a dia). E o profile padrao ja fica travado pelo Chrome
# aberto normalmente. Entao: profile dedicado = sessao logada separada,
# que persiste entre execucoes — e janela REAL, com teclado e mouse.
cmd_chrome() {
  local profile="${BOT_CHROME_PROFILE:-$HOME/.chrome-debug-profile}"

  if cdp_do_host_vivo; then
    ok "Ja existe um Chrome com CDP na porta ${CDP_PORT} — pronto para o bot."
    return 0
  fi

  c "→ Abrindo o Chrome (janela real) com CDP na porta ${CDP_PORT}..."
  mkdir -p "$profile"
  # shellcheck disable=SC2086
  setsid google-chrome \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$profile" \
    --no-first-run \
    --no-default-browser-check \
    about:blank >/dev/null 2>&1 &

  for i in $(seq 1 15); do
    sleep 1
    if cdp_do_host_vivo; then
      ok "Chrome pronto (CDP ${CDP_PORT}, profile: $profile)"
      c "   Faça login nos sites nessa janela. O perfil persiste entre execuções."
      return 0
    fi
  done
  erro "Chrome não respondeu na porta ${CDP_PORT}."
  erro "Se a porta estiver ocupada por outro processo, mude BOT_CDP_PORT no .env."
  return 1
}

case "${1:-up}" in
  up) shift || true; cmd_up "${1:-auto}" ;;
  down) cmd_down ;;
  logs) cmd_logs ;;
  status) cmd_status ;;
  shell) cmd_shell ;;
  rebuild) shift || true; cmd_rebuild "${1:-auto}" ;;
  chrome) cmd_chrome ;;
  watch) shift || true; cmd_watch "${1:-help}" ;;
  ui) cmd_ui ;;
  help|-h|--help) sed -n '2,25p' "$0" ;;
  *) erro "comando desconhecido: $1"; sed -n '2,25p' "$0"; exit 1 ;;
esac
