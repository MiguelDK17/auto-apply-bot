# ============================================================
# LLM DO AGENTE DE NAVEGACAO (agnostico, padrao OpenAI SDK)
# Funciona com: OpenRouter (padrao), OpenAI nativa, Ollama local,
# ou qualquer endpoint OpenAI-compatible (vLLM, Together, Groq...)
# Use um modelo RAPIDO com suporte a tool calling.
# ============================================================
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=sua-chave-aqui
AGENT_LLM_MODEL=google/gemini-2.0-flash-001
# Alternativas testadas:
# AGENT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# AGENT_LLM_MODEL=deepseek/deepseek-chat
# OpenAI nativa: AGENT_LLM_BASE_URL=https://api.openai.com/v1 + AGENT_LLM_MODEL=gpt-4o-mini
# Ollama local: AGENT_LLM_BASE_URL=http://localhost:11434/v1 + AGENT_LLM_MODEL=llama3.1 (+ qualquer API key)

# Chave legada do Google Gemini (opcional — usada apenas como fallback do
# LLM auxiliar se LLM_AUX_PROVIDER=gemini; o agente NAO usa mais)
GEMINI_API_KEY=

# Endpoint CDP do Chrome (abra o Chrome com: google-chrome --remote-debugging-port=9222)
# Use 127.0.0.1 (IPv4), nao "localhost": o Chrome faz bind so em 127.0.0.1 e
# "localhost" pode resolver para ::1 (IPv6), dando "ECONNREFUSED ::1:9222".
CDP_ENDPOINT=http://127.0.0.1:9222

# Modelo legado do Gemini (opcional — fallback do LLM auxiliar;
# o agente de navegacao usa AGENT_LLM_MODEL acima)
GEMINI_MODEL=gemini-2.5-flash

# Limite de candidaturas por dia
LIMITE_DIARIO=10

# Teto de envios reais por execucao (protege a conta real de rajadas)
MAX_POR_EXECUCAO=5

# Delay entre acoes (ms)
DELAY_MIN=2000
DELAY_MAX=5000

# Modo Dry-Run (true = faz tudo menos submeter a candidatura de verdade)
DRY_RUN=true

# Score minimo para aplicar (1-10, quanto maior mais restritivo)
SCORE_MINIMO=6

# Custo maximo por execucao em USD (0 = desativado; interrompe o loop se exceder)
CUSTO_MAX_USD=0

# Dashboard (porta do servidor web local)
DASHBOARD_PORT=3000

# ============================================================
# TELEGRAM (opcional — preencha para receber notificações)
# 1. Fale com @BotFather no Telegram e crie um bot
# 2. Copie o token do bot
# 3. Envie uma mensagem para o bot e acesse:
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
#    para obter seu chat_id
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# EMAIL (opcional — preencha para receber relatório por email)
# Para Gmail: use uma "Senha de App" em vez da senha normal
# Gere em: https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DESTINATARIO=

# ============================================================
# CRON (agendamento automático — desativado por padrão)
# Ative para o bot executar automaticamente no horário definido
# ============================================================
CRON_ATIVO=false
CRON_HORARIO=09:00

# ============================================================
# MULTI-LLM AUXILIAR (tarefas pesadas: cover letter, curriculo,
# mensagem recrutador. Pode ser um provedor TOTALMENTE diferente do agente.)
# Providers: gemini (padrão), ollama (local/grátis), openai
# ============================================================
LLM_AUX_PROVIDER=gemini
LLM_AUX_MODEL=gemini-2.5-flash

# Ollama (se LLM_AUX_PROVIDER=ollama)
# Instale: https://ollama.com — depois: ollama pull llama3
OLLAMA_URL=http://localhost:11434
# LLM_AUX_MODEL=llama3

# OpenAI-compatible (se LLM_AUX_PROVIDER=openai)
# Funciona com: OpenAI, Together AI, Groq, Mistral, vLLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_AUX_MODEL=gpt-4o-mini
