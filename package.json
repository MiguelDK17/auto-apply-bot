{
  "name": "auto-apply-bot",
  "version": "1.0.0",
  "description": "Agente inteligente de candidatura automatica a vagas de emprego",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "resultado": "tsx src/marcar-resultado.ts",
    "chrome": "google-chrome --remote-debugging-port=9222",
